{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "MonsoonRoute P5 inactive resources no Lambdas or active schedules",
  "Resources": {
    "ArtifactBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "monsoonroute-prod-artifacts-${AWS::AccountId}-${AWS::Region}"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "IncompleteUploadCleanup",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            },
            {
              "Id": "NoncurrentCleanup",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 7
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "MonsoonRoute"
          },
          {
            "Key": "Environment",
            "Value": "production"
          },
          {
            "Key": "WorkloadState",
            "Value": "disabled"
          }
        ]
      }
    },
    "ArtifactTLSOnly": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "ArtifactBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "EnforceTLS",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": "ArtifactBucket.Arn"
                },
                {
                  "Fn::Sub": "${ArtifactBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "VisionDLQ": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": "monsoonroute-p5-inactive-vision-dlq",
        "MessageRetentionPeriod": 1209600,
        "SqsManagedSseEnabled": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "MonsoonRoute"
          },
          {
            "Key": "WorkloadState",
            "Value": "disabled"
          }
        ]
      }
    },
    "VisionQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": "monsoonroute-p5-inactive-vision",
        "VisibilityTimeout": 720,
        "MessageRetentionPeriod": 345600,
        "ReceiveMessageWaitTimeSeconds": 20,
        "SqsManagedSseEnabled": true,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": "VisionDLQ.Arn"
          },
          "maxReceiveCount": 3
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "MonsoonRoute"
          },
          {
            "Key": "WorkloadState",
            "Value": "disabled"
          }
        ]
      }
    },
    "QueueBacklogAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "monsoonroute-p5-vision-queue-backlog",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": "VisionQueue.QueueName"
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 300,
        "EvaluationPeriods": 2,
        "Threshold": 10,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "VisionDLQAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "monsoonroute-p5-vision-dlq",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": "VisionDLQ.QueueName"
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      }
    }
  },
  "Outputs": {
    "ArtifactBucketName": {
      "Value": {
        "Ref": "ArtifactBucket"
      }
    },
    "ArtifactBucketArn": {
      "Value": {
        "Fn::GetAtt": "ArtifactBucket.Arn"
      }
    },
    "VisionQueueUrl": {
      "Value": {
        "Ref": "VisionQueue"
      }
    },
    "VisionQueueArn": {
      "Value": {
        "Fn::GetAtt": "VisionQueue.Arn"
      }
    },
    "VisionDLQUrl": {
      "Value": {
        "Ref": "VisionDLQ"
      }
    },
    "VisionDLQArn": {
      "Value": {
        "Fn::GetAtt": "VisionDLQ.Arn"
      }
    }
  }
}
