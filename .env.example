# ============================================================================
# MonsoonRoute — Environment Variable Template
# ============================================================================
# Copy to .env.local and fill in values.  This file is COMMITTED.
# NEVER put real secrets here.  See docs/env-registry.md for full reference.
# ============================================================================


# ============================================================================
# A. APP IDENTITY
# ============================================================================

# [SERVER-ONLY | NON-SECRET]  Env validation & deployment boundaries.
# Configured in: Vercel / local / CI.  Consumer: env validation.
# Allowed: local | ci | staging | production
APP_ENV=local

# [SERVER-ONLY | NON-SECRET]  Default false; rejected in production;
# never combined with hosted prod Supabase or AWS calls.
# Configured in: local / CI / isolated preview.  Consumer: fixture-build adapter.
FIXTURE_MODE=false

# [SERVER-ONLY | NON-SECRET]  Exact origin, no trailing slash.
# production = exact Vercel subdomain (https).  local = http://localhost:3000.
# Configured in: Vercel / local.  Consumer: origin checks, OAuth redirects, metadata.
APP_URL=http://localhost:3000

# [SERVER-ONLY | NON-SECRET]  Pilot city identifier.
# Configured in: Vercel / SAM env.  Consumer: all adapters/routing.
CITY_ID=delhi-central

# [SERVER-ONLY | NON-SECRET]  Published graph UUID.
# Configured in: Vercel build/release env.  Consumer: graph consistency gate.
# RESOLVED AFTER graph import (published graph UUID)
GRAPH_VERSION=

# [SERVER-ONLY | NON-SECRET]  Full compiled graph hash (64 hex chars).
# Configured in: Vercel build/release env.  Consumer: integrity check.
# RESOLVED AFTER graph build
GRAPH_SHA256=

# [SERVER-ONLY | NON-SECRET]  Exactly relative-risk-v1 for this release.
# Configured in: Vercel.  Consumer: risk/route provenance.
RULESET_ID=relative-risk-v1

# [SERVER-ONLY | NON-SECRET]  Structured logging level.
# Configured in: Vercel / SAM.  Consumer: logging.
LOG_LEVEL=INFO

# [SERVER-ONLY | NON-SECRET]  Git commit SHA from CI GITHUB_SHA; never invented.
# Configured in: Vercel build env / CI.  Consumer: status/version/audit.
# RESOLVED AFTER each build/commit
BUILD_SHA=


# ============================================================================
# B. SUPABASE — BROWSER-SAFE
# ============================================================================

# [CLIENT-SAFE | NON-SECRET]  Project HTTPS URL for Auth/Storage.
# Configured in: Vercel + local .env.local.  Consumer: browser Supabase client, SSR.
NEXT_PUBLIC_SUPABASE_URL=

# [CLIENT-SAFE | NON-SECRET]  Public project key; NOT the service key.
# Configured in: Vercel + local.  Consumer: browser/SSR user-context client.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# ============================================================================
# C. SUPABASE & SECURITY — SERVER-ONLY
# ============================================================================

# [SERVER-ONLY | NON-SECRET]  Must equal NEXT_PUBLIC_SUPABASE_URL.
# Configured in: Vercel; also Secrets Manager JSON for Lambda.
# Consumer: privileged DB/Storage clients.
SUPABASE_URL=

# [SERVER-ONLY | SECRET]  Legacy service-role JWT; never in the browser.
# Configured in: Vercel; Secrets Manager JSON (supabase_service_role_key).
# Consumer: trusted API/worker clients.
SUPABASE_SERVICE_ROLE_KEY=

# [SERVER-ONLY | SECRET]  Random >=32 bytes, base64-encoded, stable across instances.
# Generate with: openssl rand -base64 32
# Configured in: Vercel.  Consumer: quota/IP subject hashing.
RATE_LIMIT_HMAC_KEY=


# ============================================================================
# D. AWS RUNTIME (Vercel / local backend)
# ============================================================================

# [SERVER-ONLY | NON-SECRET]  Master allow/deny AWS SDK calls.
# Effective AWS = env AND DB flag.  production true initially; local false.
# Configured in: Vercel / local.  Consumer: enqueue, refresh provider, fallback.
AWS_ENABLED=false

# [SERVER-ONLY | NON-SECRET]  Must be ap-south-1.
# Configured in: Vercel / local; AWS runtime supplies region automatically.
AWS_REGION=ap-south-1

# [SERVER-ONLY | NON-SECRET]  Vercel federated role ARN, separate for staging/production.
# Configured in: Vercel production/staging.  Consumer: STS/OIDC helper.
# RESOLVED AFTER IAM OIDC bootstrap
AWS_ROLE_ARN=

# [SERVER-ONLY | NON-SECRET]  Queue URL from SAM output.
# Configured in: Vercel.  Consumer: SendMessage.
# RESOLVED AFTER sam deploy
AWS_VISION_QUEUE_URL=

# [SERVER-ONLY | NON-SECRET]  Function ARN from SAM output.
# Configured in: Vercel.  Consumer: admin InvokeFunction.
# RESOLVED AFTER sam deploy
AWS_INGEST_FUNCTION_ARN=

# [SERVER-ONLY | NON-SECRET | LOCAL ONLY]  AWS SSO profile name; absent on Vercel.
# Configured in: local only.  Consumer: local AWS SDK/CLI.
AWS_PROFILE=


# ============================================================================
# E. LAMBDA VARIABLES (LAMBDA-ONLY)
# ============================================================================
# These map to SAM parameters and are NOT read by Next.js.
# Lambda gets Supabase URL and service key from Secrets Manager JSON
# {"supabase_url","supabase_service_role_key"}, NOT from env.
# SAM parameter mappings noted in parentheses.

# [LAMBDA-ONLY | NON-SECRET]  AWS secret ARN containing URL/backend key.
# Configured in: SAM parameter → Lambda env (BackendSecretArn).
# Consumer: all Lambda secret loaders.
# RESOLVED AFTER Secrets Manager secret creation
BACKEND_SECRET_ARN=

# [LAMBDA-ONLY | NON-SECRET]  Private S3 bucket from SAM output.
# Configured in: SAM env.  Consumer: ingestion/vision/maintenance.
# RESOLVED AFTER sam deploy
ARTIFACT_BUCKET=

# [LAMBDA-ONLY | NON-SECRET]  Same SQS queue, worker-repair name.
# Configured in: maintenance Lambda SAM env.  Consumer: maintenance SendMessage.
# RESOLVED AFTER sam deploy
VISION_QUEUE_URL=

# [LAMBDA-ONLY | NON-SECRET]  Exact model identifier (case-sensitive).
# Configured in: vision SAM env + model manifest.  Consumer: result provenance.
HF_MODEL_ID=prithivMLmods/Flood-Image-Detection

# [LAMBDA-ONLY | NON-SECRET]  Full 40-char HF model commit SHA (ModelRevision).
# Configured in: SAM parameter → vision env.  Consumer: artifact provenance.
# RESOLVED AFTER model export
MODEL_REVISION=

# [LAMBDA-ONLY | NON-SECRET]  Immutable ONNX S3 key (ModelKey).
# Configured in: SAM parameter → vision env.  Consumer: model download.
# RESOLVED AFTER model export and S3 upload
MODEL_KEY=

# [LAMBDA-ONLY | NON-SECRET]  Hash of exported ONNX, 64 hex chars (ModelSha256).
# Not the original safe weights hash.
# Configured in: SAM parameter → vision env.  Consumer: integrity check.
# RESOLVED AFTER model export
MODEL_SHA256=

# [LAMBDA-ONLY | NON-SECRET]  Immutable processor recipe S3 key (PreprocessorKey).
# Configured in: SAM parameter → vision env.  Consumer: preprocessing download.
# RESOLVED AFTER model export and S3 upload
PREPROCESSOR_KEY=

# [LAMBDA-ONLY | NON-SECRET]  Hash of preprocessor recipe, 64 hex chars (PreprocessorSha256).
# Configured in: SAM parameter → vision env.  Consumer: integrity check.
# RESOLVED AFTER model export
PREPROCESSOR_SHA256=

# [LAMBDA-ONLY | NON-SECRET]  ONNX inter-op threads.
# Configured in: vision SAM env.  Consumer: ONNX session.
ORT_THREADS=2


# ============================================================================
# F. BUILD & DEPLOYMENT CREDENTIALS (DEPLOY-ONLY)
# ============================================================================
# Never Lambda, browser, or runtime API.

# [DEPLOY-ONLY | SECRET | OPTIONAL]  Read-only Hub token for build downloads.
# Configured in: local secure env / GitHub protected environment.
# Consumer: model resolver/export script.
HF_TOKEN=

# [DEPLOY-ONLY | NON-SECRET]  Target hosted project identifier.
# Configured in: deployment env.  Consumer: CLI & Management API scripts.
SUPABASE_PROJECT_REF=

# [DEPLOY-ONLY | SECRET]  Management/CLI auth token; narrowly permitted.
# Configured in: deployment-only secret.  Consumer: hosted config/migration workflow.
SUPABASE_ACCESS_TOKEN=

# [DEPLOY-ONLY | SECRET]  CLI remote database migration password.
# Configured in: deployment-only secret.  Consumer: Supabase CLI deployment.
SUPABASE_DB_PASSWORD=

# [DEPLOY-ONLY | SECRET]  TLS Postgres connection for graph import/role bootstrap.
# Use pooler/session endpoint as appropriate.
# Configured in: deployment-only secret.  Consumer: seed/import and security-test scripts.
DATABASE_URL=

# [DEPLOY-ONLY | NON-SECRET]  GitHub OAuth app identifier.
# Configured in: Supabase Auth / local config.
# Consumer: auth configuration script; consumed by supabase/config.toml via env().
GITHUB_OAUTH_CLIENT_ID=

# [DEPLOY-ONLY | SECRET]  GitHub OAuth app secret.
# Configured in: Supabase Auth; never Vercel browser.
# Consumer: auth configuration script; consumed by supabase/config.toml via env()
#   and the Management API script.
GITHUB_OAUTH_CLIENT_SECRET=

# [DEPLOY-ONLY | NON-SECRET]  IAM/budget bootstrap account.
# Configured in: deployment env.  Consumer: OIDC/SAM/IAM renderer.
AWS_ACCOUNT_ID=

# [DEPLOY-ONLY | NON-SECRET]  GitHub OIDC deployment role.
# Configured in: GitHub protected environment.  Consumer: GitHub deploy workflow.
# RESOLVED AFTER IAM OIDC bootstrap
AWS_DEPLOY_ROLE_ARN=

# [DEPLOY-ONLY | NON-SECRET]  Deployment-only private S3 package bucket.
# Pattern: monsoonroute-deploy-{AWS_ACCOUNT_ID}-ap-south-1
# Configured in: protected deployment config.  Consumer: SAM packaging/deploy.
AWS_DEPLOY_BUCKET=

# [DEPLOY-ONLY | NON-SECRET]  Exact repository subject inputs for OIDC trust.
# Configured in: bootstrap config.  Consumer: IAM trust renderer.
GITHUB_OWNER=
GITHUB_REPO=

# [DEPLOY-ONLY | NON-SECRET]  Exact OIDC issuer/audience and owner slug.
# Configured in: bootstrap input.  Consumer: IAM trust renderer.
VERCEL_TEAM_SLUG=

# [DEPLOY-ONLY | NON-SECRET]  Exact Vercel OIDC subject project name.
# Configured in: bootstrap input.  Consumer: IAM trust renderer.
VERCEL_PROJECT_NAME=

# [DEPLOY-ONLY | NON-SECRET]  Vercel CLI target organization ID.
# Configured in: deployment config.  Consumer: Vercel CLI workflow.
VERCEL_ORG_ID=

# [DEPLOY-ONLY | NON-SECRET]  Vercel CLI target project ID.
# Configured in: deployment config.  Consumer: Vercel CLI workflow.
VERCEL_PROJECT_ID=

# [DEPLOY-ONLY | SECRET]  Deployment/API token for CLI GitHub deployment.
# Configured in: protected deployment-only secret.  Consumer: Vercel CLI.
VERCEL_TOKEN=

# [DEPLOY-ONLY | NON-SECRET | PRIVATE]  Account owner budget alert recipient.
# Configured in: private deployment config.  Consumer: budget bootstrap script.
AWS_BUDGET_EMAIL=

# [DEPLOY-ONLY | NON-SECRET | PRIVATE]  Supabase auth UUID for first admin.
# Check against auth.users before seeding.
# Configured in: private bootstrap input.  Consumer: role bootstrap SQL/script.
ADMIN_USER_ID=


# ============================================================================
# G. OPTIONAL EVALUATION IMPORTER
# ============================================================================
# Only ONE credential mechanism may be set.  Leave all commented out by default.

# [OPTIONAL | SECRET | DEPLOY-ONLY]  Legacy Kaggle download authentication.
# Consumer: optional approved evaluation importer.
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# [OPTIONAL | SECRET | DEPLOY-ONLY]  Current token mechanism (alternative).
# Consumer: optional evaluation importer.
# KAGGLE_API_TOKEN=


# ============================================================================
# H. FUTURE SCOPE — not configured for the hackathon
# ============================================================================
# [FUTURE]  NIM / LLM summary integration.  Server-only.
# Do not uncomment or configure for the hackathon build.

# NVIDIA_API_KEY=
# NIM_MODEL_ID=meta/llama-3.1-8b-instruct
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_SUMMARY_ENABLED=false


# ============================================================================
# I. NEVER SET — platform-provided or temporary credentials only
# ============================================================================
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN:
#   Temporary STS/SSO/Lambda-role credentials only.
#   Never committed or reused as long-lived keys.
#
# VERCEL_ENV, VERCEL_REGION, and the Vercel OIDC token:
#   Platform-provided at runtime.  Do not manually copy or log.
