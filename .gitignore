# ============================================================================
# MonsoonRoute — .gitignore
# ============================================================================

# --- Environment & secrets -------------------------------------------------
.env
.env.local
.env.*.local
!.env.example
*.pem

# Credential / token JSON files
**/credentials.json
**/service-account*.json
kaggle.json
*credentials*.json
*secret*.json

# Supabase local temp
supabase/.temp/

# --- Dependencies ----------------------------------------------------------
node_modules/
.pnp.*
.yarn/install-state.gz

# --- Build outputs ---------------------------------------------------------
.next/
out/
dist/
build/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- IDE & OS --------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Logs ------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Artifacts & caches ---------------------------------------------------
.cache/
.turbo/
.vercel/
coverage/
*.tsbuildinfo

# --- AWS SAM ---------------------------------------------------------------
.aws-sam/
samconfig.toml

# --- Model artifacts (large files) -----------------------------------------
*.onnx
*.safetensors
*.bin
*.h5
