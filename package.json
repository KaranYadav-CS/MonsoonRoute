{
  "name": "monsoonroute",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/unit/*.test.mjs tests/security/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test",
    "check:artifacts": "python scripts/check_artifacts.py",
    "check:python": "python -m unittest discover -s tests/integration -p 'test_*.py'",
    "demo:build": "node scripts/build_offline_demo.mjs",
    "demo:serve": "python -m http.server 8000",
    "check:syntax": "node scripts/check_syntax.mjs",
    "check:workers": "python scripts/package_workers.py",
    "check:browser": "python scripts/verify_demo_browser.py"
  },
  "dependencies": {
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.57.4",
    "@vercel/functions": "3.9.9",
    "@aws-sdk/client-s3": "3.893.0",
    "@aws-sdk/client-sqs": "3.893.0",
    "@aws-sdk/client-lambda": "3.893.0",
    "maplibre-gl": "5.7.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.34.4",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "eslint": "9.36.0",
    "eslint-config-next": "16.4.0",
    "typescript": "5.9.3",
    "@playwright/test": "1.56.0"
  }
}
